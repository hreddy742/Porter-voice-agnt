# ============================================================
# Porter Capital Voice Agent (Aiva) — environment configuration
# Copy this file to .env and fill in real values.
# ============================================================

# ---- Database (Postgres) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=porter
DB_USER=postgres
DB_PASSWORD=postgres

# How many days to wait before recontacting a lead marked callback_later.
RECONTACT_DEFAULT_DAYS=7

# ---- LiveKit (voice pipeline + SIP room orchestration) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Only override if your LiveKit Cloud project's Twilio connector differs
# from the default baked into app/calling/dialer.py.
# LIVEKIT_TWILIO_WS_URL=wss://your-project.sip.livekit.cloud/twilio

# ---- Twilio (outbound telephony) ----
# Account SID must start with AC (not SK).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional alternative to TWILIO_AUTH_TOKEN: an API Key (SK...) + secret.
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=

# ---- Test dialing ----
# When true, dialer.py rings MY_PHONE_NUMBER instead of the selected
# lead's real number (the lead is still selected and tagged normally, so
# the agent's context/testing path is otherwise identical to production).
TEST_MODE=true
MY_PHONE_NUMBER=

# ---- LLM provider selection (app/agent/providers.py) ----
# One of: grok | xai | groq | claude | gpt | qwen | mistral-local | gptoss
LLM_PROVIDER=grok
# Optional automatic failover if the primary LLM errors mid-call.
LLM_FAILOVER_PROVIDER=

# Provider credentials — only the ones matching LLM_PROVIDER /
# LLM_FAILOVER_PROVIDER are required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
GROK_MODEL=xai/grok-4-1-fast-non-reasoning

# Local models via Ollama (qwen / mistral-local / gptoss providers).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_KEEP_ALIVE=30m

# ---- TTS provider selection (app/agent/providers.py) ----
# One of: cartesia | kokoro | chatterbox | elevenlabs
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
# Local OpenAI-compatible TTS servers (kokoro / chatterbox providers).
# KOKORO_BASE_URL=http://localhost:8880/v1
# CHATTERBOX_BASE_URL=http://localhost:8880/v1

# ---- STT ----
DEEPGRAM_API_KEY=

# ---- Opener task tuning (app/agent/tasks/opener.py) ----
# How long Aiva waits for a response to each "Hello?" before escalating.
OPENER_WAIT_TIMEOUT_SECONDS=3.5
# How many "Hello?" attempts before giving up on a silent line.
OPENER_MAX_HELLO_ATTEMPTS=3
